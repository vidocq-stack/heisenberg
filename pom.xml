    <properties>
        <!-- MicroProfile Fault Tolerance 4.1 API. The upstream jar is not modular: heisenberg-mp-ft-api
             repackages it with a module-info (module microprofile.fault.tolerance.api). -->
        <microprofile.fault.tolerance.version>4.1</microprofile.fault.tolerance.version>

        <!-- Jakarta CDI 4.1 (Jakarta EE 11) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Jakarta Interceptors 2.2 (Jakarta EE 11) -->
        <jakarta.interceptor.version>2.2.0</jakarta.interceptor.version>

        <!--
            MicroProfile Config 3.1.1 — version avec Automatic-Module-Name:
            "org.eclipse.microprofile.config" ajouté dans le manifest depuis 2026-04-22.
        -->
        <microprofile.config.version>3.1.1</microprofile.config.version>

        <!-- Implémentations Vidocq upstream -->
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
        <ravel.version>0.4.0-SNAPSHOT</ravel.version>
        <dirac.version>0.4.0-SNAPSHOT</dirac.version>

        <!-- JMH pour heisenberg-bench -->
        <jmh.version>1.37</jmh.version>

        <!--
            The TCK this repository's pull requests are gated on (Vidocq/GestionProjet#9). Read by
            the shared pr-validate workflow, which skips the step when this property is absent.

            The certification profile is named explicitly because a plain `-Ptck` would not run it:
            the root `tck` profile only adds heisenberg-tck to the reactor, and inside heisenberg-tck
            the `smoke` profile is activeByDefault. `-Ptck` alone would therefore pass on a subset
            while reporting success — the vacuous gate this campaign exists to remove.

            Measured on a clean local repository (empty ~/.m2, the state of a CI runner): the
            official MicroProfile Fault Tolerance 4.1 TCK runs 463 tests in 174 s, all green, every
            artefact resolved from Maven Central. That cost is deliberate and irreducible: fault
            tolerance IS durations (testTimeout, testRetryWithDelay, testBulkheadPressure), so the
            suite spends most of its time waiting on purpose. Three minutes on a pull request buys
            the only automated proof that this implementation still conforms.
        -->
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl heisenberg-tck test</ci.tck.command>
    </properties>

    <!--
        heisenberg-tck joins the reactor only under the `tck` profile (see <profiles>
        below), mirroring the vidocq-runtime-tck-* pattern: a plain `mvn install`
        neither downloads nor runs the TCK, and the release reactor never sees it.
        The historical out-of-reactor constraint (ShrinkWrap Maven Resolver 3.3
        vs Model 4.1.0 POMs) disappeared with the Maven 3.9.16 / Model 4.0.0
        migration; the MP Fault Tolerance TCK builds its deployments with
        addClass/addPackage and does not use the ShrinkWrap Maven resolver, so it
        runs safely in-reactor (same verification as vidocq-runtime-tck-heisenberg-faulttolerance).
    -->
    <modules>
        <module>heisenberg-mp-ft-api</module>
        <module>heisenberg-api</module>
        <module>heisenberg-core</module>
        <module>heisenberg-cdi-vauban</module>
        <module>heisenberg-cdi-vauban-module-it</module>
        <module>heisenberg-bench</module>
        <module>heisenberg-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Fault Tolerance 4.1 API — version modularisée (named module, jlink-compatible) -->
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-mp-ft-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- API officielle conservée pour le TCK hors-reactor uniquement -->
            <dependency>
                <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
                <artifactId>microprofile-fault-tolerance-api</artifactId>
                <version>${microprofile.fault.tolerance.version}</version>
            </dependency>

            <!-- Jakarta CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Jakarta Interceptors -->
            <dependency>
                <groupId>jakarta.interceptor</groupId>
                <artifactId>jakarta.interceptor-api</artifactId>
                <version>${jakarta.interceptor.version}</version>
            </dependency>

            <!-- MicroProfile Config — version modularisée Ravel (named module, jlink-compatible) -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            <!-- MicroProfile Metrics API — version modularisée Dirac (named module, jlink-compatible) -->
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-mp-metrics-api</artifactId>
                <version>${dirac.version}</version>
            </dependency>
            <!-- API officielle conservée pour le TCK hors-reactor uniquement -->
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>

            <!-- Implémentations Vidocq (utilisées en test scope ou runtime) -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Modules internes Heisenberg -->
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <profiles>
        <!--
            TCK harmonisation (workspace-wide effort, dirac = pilot brick): the
            official MicroProfile Fault Tolerance 4.1 TCK runner joins the reactor
            only when this profile is active, exactly like the in-reactor
            vidocq-runtime-tck-* runners of the vidocq runtime.

                ./mvnw -Ptck -pl heisenberg-tck test                     # smoke
                ./mvnw -Ptck,tck-official -pl heisenberg-tck test        # full suite

            run-official-tck-mp-fault-tolerance-4.1.sh remains the friendly wrapper.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>heisenberg-tck</module>
            </modules>
        </profile>
    </profiles>
</project>
