<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.heisenberg</groupId>
    <artifactId>heisenberg-parent</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Heisenberg</name>
    <description>Implémentation MicroProfile Fault Tolerance 4.1 — zéro librairie tierce, virtual threads, Java Modules strict, CDI via Vauban, config via Ravel</description>
    <url>https://codefloe.com/Vidocq/heisenberg</url>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://forge.vidocq.dev/vidocq/heisenberg</url>
        <connection>scm:git:https://forge.vidocq.dev/vidocq/heisenberg.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/heisenberg.git</developerConnection>
    </scm>

    <properties>
        
        <microprofile.fault.tolerance.version>4.1</microprofile.fault.tolerance.version>

        
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        
        <jakarta.interceptor.version>2.2.0</jakarta.interceptor.version>

        
        <microprofile.config.version>3.1.1</microprofile.config.version>

        
        <vauban.version>0.4.0-RC1</vauban.version>
        <ravel.version>0.4.0-RC1</ravel.version>
        <dirac.version>0.4.0-RC1</dirac.version>

        
        <jmh.version>1.37</jmh.version>

        
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl heisenberg-tck test</ci.tck.command>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/heisenberg-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.exclusions>**/heisenberg-examples/**</sonar.coverage.exclusions>
        <sonar.issue.ignore.multicriteria>examples</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
        <sonar.issue.ignore.multicriteria.examples.resourceKey>**/heisenberg-examples/**/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
    </properties>

    
    <modules>
        <module>heisenberg-mp-ft-api</module>
        <module>heisenberg-api</module>
        <module>heisenberg-core</module>
        <module>heisenberg-cdi-vauban</module>
        <module>heisenberg-cdi-vauban-module-it</module>
        <module>heisenberg-it-other-containers</module>
        <module>heisenberg-bench</module>
        <module>heisenberg-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-mp-ft-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <dependency>
                <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
                <artifactId>microprofile-fault-tolerance-api</artifactId>
                <version>${microprofile.fault.tolerance.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.interceptor</groupId>
                <artifactId>jakarta.interceptor-api</artifactId>
                <version>${jakarta.interceptor.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-mp-metrics-api</artifactId>
                <version>${dirac.version}</version>
            </dependency>
            
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.heisenberg</groupId>
                <artifactId>heisenberg-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <profiles>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>heisenberg-tck</module>
            </modules>
        </profile>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>heisenberg-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>