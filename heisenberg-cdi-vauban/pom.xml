<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.heisenberg</groupId>
        <artifactId>heisenberg-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>heisenberg-cdi-vauban</artifactId>
    <name>Heisenberg :: CDI Vauban Integration</name>
    <description>Intercepteur CDI Fault Tolerance (FaultToleranceInterceptor, priorité 4010) et BCE Vauban (HeisenbergExtension, StateRegistryBean)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MP Metrics API — version modularise Dirac (named module, jlink-compatible), provided en runtime -->
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-mp-metrics-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            OpenTelemetry API : utilis par OtelFtMetricsRecorder pour publier les mtriques §10
            (ft.invocations.total, ft.retry.calls.total, etc.) via GlobalOpenTelemetry.
            Optionnel  l'excution (le bean est silencieusement ignor par CDI si OTel absent).
            justifi par dependency-gatekeeper : §10 de la spec MP Fault Tolerance 4.1.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.39.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Container CDI Vauban pour les tests d'intégration -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation Config pour les tests (Ravel) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen : META-INF/vauban-beans.list + _ClientProxy/_Factory pour la découverte
                runtime (scanClasspath). BCE dans un package exporté → pas d'opens. Weld-safe (cf. knock).
            -->
            <plugin>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-maven-plugin</artifactId>
                <version>${vauban.version}</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals><goal>generate</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Copie supplmentaire pour opentelemetry-api (scope=provided) dans
                target/javamodules/ : le plugin parent ne copie que compile-scope, mais OTel
                est utilis par OtelFtMetricsRecorder pour compiler le module-info JPMS.
                AMBN = io.opentelemetry.api (vrifi dans MANIFEST.MF de la 1.39.0).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-otel-api-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.opentelemetry</groupId>
                                    <artifactId>opentelemetry-api</artifactId>
                                    <version>1.39.0</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.opentelemetry</groupId>
                                    <artifactId>opentelemetry-context</artifactId>
                                    <version>1.39.0</version>
                                    <type>jar</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                JPMS workaround heisenberg-cdi-vauban : même problème que heisenberg-core.
                vauban-core et ravel-core sont test-scope, absents de target/javamodules/.
                Si module-info.class est dans target/classes, Maven active JPMS pour
                testCompile et ne trouve pas les modules test sur le module-path.
                Même solution en trois temps (voir heisenberg-core/pom.xml).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-module-info-before-testcompile</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
