<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.heisenberg</groupId>
        <artifactId>heisenberg-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>heisenberg-cdi-vauban</artifactId>
    <name>Heisenberg :: CDI Vauban Integration</name>
    <description>Fault Tolerance CDI interceptor (FaultToleranceInterceptor, priority 4010) and Vauban BCE (HeisenbergExtension, StateRegistryBean)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MP Metrics API — version modularise Dirac (named module, jlink-compatible), provided en runtime -->
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-mp-metrics-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            OpenTelemetry API : utilis par OtelFtMetricsRecorder pour publier les mtriques §10
            (ft.invocations.total, ft.retry.calls.total, etc.) via GlobalOpenTelemetry.
            Optionnel  l'excution (le bean est silencieusement ignor par CDI si OTel absent).
            justifi par dependency-gatekeeper : §10 de la spec MP Fault Tolerance 4.1.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.39.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Compile-only (optional at runtime): supplies the VaubanComponentProvider service type
             named in module-info `provides`. Non-transitive; absent under non-Vauban containers. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Vauban CDI container for the integration tests -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Config implementation for the tests (Ravel) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans (the Maven
                plugin is reserved for freezing external, non-APT dependency jars). It generates
                _ClientProxy/_Factory, META-INF/vauban-beans.list and _VaubanComponents (in-module
                instantiation + field injection of the FT interceptors and recorder beans, no opens).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Library module, not a complete deployment: the FT interceptors inject
                         @Any Instance<FtMetricsRecorder> and config beans resolved across the
                         deployment; deployment validation runs at the Vidocq runtime assembly. -->
                    <compilerArgs>
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Tests run on the module path, test classes patched into io.vidocq.heisenberg.cdi.vauban.
                Test-only grants, which no production module needs:
                - add-reads to io.vidocq.vauban.core: vauban-core is a test-scope dependency that the
                  module does not require, yet one test builds a VaubanContainer directly;
                - opens of the test package to io.vidocq.vauban.core: the test beans have no generated
                  provider, so Vauban reaches them reflectively;
                - read edge from io.vidocq.heisenberg.core to this module, and opens of the test
                  package to it: FallbackResolver resolves the test beans' fallback methods through
                  MethodHandles.privateLookupIn, which needs both.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-reads io.vidocq.heisenberg.cdi.vauban=io.vidocq.vauban.core
                        --add-reads io.vidocq.heisenberg.core=io.vidocq.heisenberg.cdi.vauban
                        --add-opens io.vidocq.heisenberg.cdi.vauban/io.vidocq.heisenberg.cdi.internal=io.vidocq.heisenberg.core,io.vidocq.vauban.core
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
