<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.heisenberg</groupId>
        <artifactId>heisenberg-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>heisenberg-cdi-vauban</artifactId>
    <name>Heisenberg :: CDI Vauban Integration</name>
    <description>Intercepteur CDI Fault Tolerance (FaultToleranceInterceptor, priorité 4010) et BCE Vauban (HeisenbergExtension, StateRegistryBean)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MP Metrics API — version modularise Dirac (named module, jlink-compatible), provided en runtime -->
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-mp-metrics-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            OpenTelemetry API : utilis par OtelFtMetricsRecorder pour publier les mtriques §10
            (ft.invocations.total, ft.retry.calls.total, etc.) via GlobalOpenTelemetry.
            Optionnel  l'excution (le bean est silencieusement ignor par CDI si OTel absent).
            justifi par dependency-gatekeeper : §10 de la spec MP Fault Tolerance 4.1.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.39.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Compile-only (optional at runtime): supplies the VaubanComponentProvider service type
             named in module-info `provides`. Non-transitive; absent under non-Vauban containers. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Container CDI Vauban pour les tests d'intégration -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation Config pour les tests (Ravel) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Copie supplmentaire pour opentelemetry-api (scope=provided) dans
                target/javamodules/ : le plugin parent ne copie que compile-scope, mais OTel
                est utilis par OtelFtMetricsRecorder pour compiler le module-info Java Modules.
                AMBN = io.opentelemetry.api (vrifi dans MANIFEST.MF de la 1.39.0).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-otel-api-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.opentelemetry</groupId>
                                    <artifactId>opentelemetry-api</artifactId>
                                    <version>1.39.0</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.opentelemetry</groupId>
                                    <artifactId>opentelemetry-context</artifactId>
                                    <version>1.39.0</version>
                                    <type>jar</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Java Modules workaround heisenberg-cdi-vauban : même problème que heisenberg-core.
                vauban-core et ravel-core sont test-scope, absents de target/javamodules/.
                Si module-info.class est dans target/classes, Maven active Java Modules pour
                testCompile et ne trouve pas les modules test sur le module-path.
                Même solution en trois temps (voir heisenberg-core/pom.xml).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <!-- process-resources runs before default-compile: removes any module-info.class
                         left in target/classes by a prior build's compile-module-info (prepare-package).
                         Without this, a no-clean `mvn install` (as the TCK runner does) lets javac
                         detect the stale descriptor and switch the main compile to module mode, failing
                         to resolve the dependency modules. -->
                    <execution>
                        <id>remove-stale-module-info</id>
                        <phase>process-resources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans (the Maven
                plugin is reserved for freezing external, non-APT dependency jars). It generates
                _ClientProxy/_Factory, META-INF/vauban-beans.list and _VaubanComponents (in-module
                instantiation + field injection of the FT interceptors and recorder beans, no opens).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Library module, not a complete deployment: the FT interceptors inject
                         @Any Instance<FtMetricsRecorder> and config beans resolved across the
                         deployment; deployment validation runs at the Vidocq runtime assembly. -->
                    <compilerArgs>
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
