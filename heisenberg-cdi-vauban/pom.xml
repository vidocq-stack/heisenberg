<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.heisenberg</groupId>
        <artifactId>heisenberg-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>heisenberg-cdi-vauban</artifactId>
    <name>Heisenberg :: CDI Vauban Integration</name>
    <description>Fault Tolerance CDI interceptor (FaultToleranceInterceptor, priority 4010) and Vauban BCE (HeisenbergExtension, StateRegistryBean)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MP Metrics API, Dirac's modular build (named module, jlink-compatible). Optional at runtime:
             without it DiracFtMetricsRecorder stays inactive (BUG-005). -->
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-mp-metrics-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            OpenTelemetry API: OtelFtMetrics publishes the §10 metrics (ft.invocations.total,
            ft.retry.calls.total, ...) through GlobalOpenTelemetry. Optional at runtime: without it
            OtelFtMetricsRecorder stays inactive (BUG-005). Justified by dependency-gatekeeper:
            §10 of the MP Fault Tolerance 4.1 specification.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.39.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Runtime dependency under any CDI container, not only Vauban: the build weaves a
             `(io.vidocq.vauban.api.ProxyLink)` entry constructor into the normal-scoped beans
             (StateRegistryBean, BulkheadStateRegistryBean, the metrics recorders). Without this jar
             Weld cannot load their classes and skips the beans silently (WELD-000119), then fails
             the deployment on the unsatisfied injection points of the interceptor. API types only,
             no code runs outside Vauban (vidocq-workspace#15, heisenberg-it-weld). The Jakarta CDI
             APIs it declares are excluded: like every Jakarta API here they come from the container
             (`provided`), and a CDI 4.0 server (Open Liberty, MicroProfile 7) must not find CDI 4.1
             API jars in the application. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Vauban CDI container: compile-only for ModuleLookups (requires static, optional at
             runtime — the container brings it), and the container of the integration tests. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Config implementation for the tests (Ravel) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans (the Maven
                plugin is reserved for freezing external, non-APT dependency jars). It generates
                _ClientProxy/_Factory, META-INF/vauban-beans.list and _VaubanComponents (in-module
                instantiation + field injection of the FT interceptors and recorder beans, no opens).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Library module, not a complete deployment: the FT interceptors inject
                         @Any Instance<FtMetricsRecorder> and config beans resolved across the
                         deployment; deployment validation runs at the Vidocq runtime assembly. -->
                    <compilerArgs>
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Tests run on the module path, test classes patched into io.vidocq.heisenberg.cdi.vauban.
                Test-only grants, which no production module needs:
                - opens of the test package to io.vidocq.vauban.core: the test beans have no generated
                  provider, so Vauban reaches them reflectively;
                - opens of the test package to io.vidocq.heisenberg.core: most tests call the
                  interceptor with no container, so no module lookup is available and
                  FallbackResolver falls back to its own private lookup. That keeps the "opens alone
                  is enough" path covered: the read edge it also needs is added by FallbackResolver
                  itself (BUG-003), hence no add-reads.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-opens io.vidocq.heisenberg.cdi.vauban/io.vidocq.heisenberg.cdi.internal=io.vidocq.heisenberg.core,io.vidocq.vauban.core
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
