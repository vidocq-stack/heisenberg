<?xml version="1.0" encoding="UTF-8"?>
<!--
    Heisenberg on Open Liberty (MicroProfile 7 distribution). mpFaultTolerance stays off, otherwise
    Liberty's own implementation would apply the policies. mpConfig is on: the configuration keys of
    MP FT 4.1 §12 are read through the server's MicroProfile Config, as in any application.
-->
<server description="heisenberg-it-openliberty">
    <featureManager>
        <feature>cdi-4.0</feature>
        <feature>restfulWS-3.1</feature>
        <feature>mpConfig-3.1</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="localhost" httpPort="${http.port}" httpsPort="${https.port}"/>

    <webApplication location="heisenberg-it-openliberty.war" contextRoot="/heisenberg"/>
</server>
