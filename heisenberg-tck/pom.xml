<?xml version="1.0" encoding="UTF-8"?>
<!--
    In-reactor TCK runner, gated by the `tck` Maven profile of heisenberg-parent
    (TCK harmonisation — workspace-wide effort, mirroring the
    vidocq-runtime-tck-* pattern): a plain `mvn install` neither downloads nor
    runs anything TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration,
    and the MP Fault Tolerance TCK builds its deployments with
    addClass/addPackage only (no ShrinkWrap Maven resolver), so it is safe
    in-reactor.

    Internal dependency versions (heisenberg-api/core/cdi-vauban, vauban-core,
    ravel-core, microprofile-fault-tolerance-api) are managed by heisenberg-parent.

    Execution goes through the script (thin wrapper over the reactor):
        ./run-official-tck-mp-fault-tolerance-4.1.sh              (smoke test)
        ./run-official-tck-mp-fault-tolerance-4.1.sh all          (full suite)
        ./run-official-tck-mp-fault-tolerance-4.1.sh -Dtest=Foo   (targeted class)

    Or directly:
        ./mvnw -Ptck -pl heisenberg-tck test                      (smoke)
        ./mvnw -Ptck,tck-official -pl heisenberg-tck test         (full suite)

    MicroProfile Fault Tolerance 4.1 TCK:
        org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck:4.1
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.heisenberg</groupId>
        <artifactId>heisenberg-parent</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>heisenberg-tck</artifactId>
    <packaging>jar</packaging>

    <name>Heisenberg :: TCK Runner</name>
    <description>Harness de conformance MicroProfile Fault Tolerance 4.1 — TCK officiel TestNG/Arquillian</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <humboldt.version>0.3.0-SNAPSHOT</humboldt.version>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
                Aligner arquillian sur 1.10.1.Final pour éviter MalformedParameterizedTypeException
                sous JDK 25 (même contournement que knock-tck / cassini-tck / cyrano-tck).
            -->
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-spi</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.core</groupId>
                <artifactId>arquillian-core-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <!-- Force CDI API 4.1.0 finale -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Heisenberg (managed by heisenberg-parent at ${project.version}) -->
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-cdi-vauban</artifactId>
        </dependency>

        <!-- MP FT API -->
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
        </dependency>

        <!-- Vauban CDI container -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <!-- Ravel Config -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
        </dependency>

        <!-- JUnit Jupiter pour smoke test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Test harness, never published (same rule as heisenberg-bench). -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
            <!--
                Classpath-only harness: neutralise the Java Modules wiring
                inherited from heisenberg-parent. The TCK archives are
                unnamed-module CDI deployments; putting the MicroProfile
                originals on the module path would duplicate the modules
                carried by the heisenberg-mp-ft-api / ravel-mp-config-api /
                dirac-mp-metrics-api repacks.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration combine.self="override">
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Profil par défaut : smoke test JUnit — vérifie que les modules Heisenberg
            se chargent correctement et que la spec MP FT 4.1 est sur le classpath.
        -->
        <profile>
            <id>smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>io/vidocq/heisenberg/tck/arquillian/**</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <excludes>
                                <exclude>io/vidocq/heisenberg/tck/arquillian/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Profil TCK officiel : Arquillian TestNG + container Heisenberg custom
            (HeisenbergDeployableContainer démarrant Vauban embedded — voir ROADMAP.md M9).
            Cible : 100 % PASS.
        -->
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                                <include>**/*IT.class</include>
                            </includes>
                            <excludes>
                                <exclude>**/HeisenbergTckSmokeTest.class</exclude>
                            </excludes>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                            <systemPropertyVariables>
                                <arquillian.launch>heisenberg</arquillian.launch>
                                <!--
                                    Multiplicateur de timeout : scale tous les délais TCK
                                    pour les environnements CI lents.
                                    Valeur par défaut : 1.0 — augmenter à 2.0 ou 3.0 si
                                    les tests @Timeout échouent par faux positifs.
                                -->
                                <org.eclipse.microprofile.fault.tolerance.tck.timeout.multiplier>1.0</org.eclipse.microprofile.fault.tolerance.tck.timeout.multiplier>
                            </systemPropertyVariables>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-testng</artifactId>
                                <version>3.5.5</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <!-- TCK MicroProfile Fault Tolerance 4.1 -->
                <dependency>
                    <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
                    <artifactId>microprofile-fault-tolerance-tck</artifactId>
                    <version>${microprofile.fault.tolerance.version}</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>org.jboss.arquillian.testng</groupId>
                    <artifactId>arquillian-testng-container</artifactId>
                    <version>1.10.1.Final</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>io.vidocq.dirac</groupId>
                    <artifactId>dirac-cdi-vauban</artifactId>
                    <version>0.3.0</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>io.vidocq.humboldt</groupId>
                    <artifactId>humboldt-cdi</artifactId>
                    <version>${humboldt.version}</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                    <version>7.10.2</version>
                    <scope>test</scope>
                </dependency>

                <!-- Jakarta CDI API 4.1 -->
                <dependency>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                    <version>4.1.0</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.interceptor</groupId>
                    <artifactId>jakarta.interceptor-api</artifactId>
                    <version>2.2.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
