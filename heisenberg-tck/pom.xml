<?xml version="1.0" encoding="UTF-8"?>
<!--
    Projet Maven STANDALONE en Model Version 4.0.0, volontairement EN DEHORS
    du reactor Heisenberg.

    Pourquoi : ShrinkWrap Maven Resolver 3.3 (dépendance transitive Arquillian) utilise
    maven-resolver 1.9 / maven-model 3.9 qui ne savent pas parser les POMs Model 4.1.0
    du reactor. Son ClasspathWorkspaceReader crasherait sur tout POM Heisenberg
    (version implicite via parent).

    Dépendances internes (heisenberg-api/core/cdi-vauban) sont gelées sur la version
    0.1.0-SNAPSHOT installée dans le repository Maven local.

    Le lancement passe par le script :
        ./run-official-tck-mp-fault-tolerance-4.1.sh              (smoke test)
        ./run-official-tck-mp-fault-tolerance-4.1.sh all          (suite complète TestNG)
        ./run-official-tck-mp-fault-tolerance-4.1.sh -Dtest=Foo   (classe ciblée)

    TCK MicroProfile Fault Tolerance 4.1 :
        org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck:4.1
    Vérification de disponibilité sur Maven Central :
        mvn dependency:get -Dartifact=org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck:4.1
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.heisenberg</groupId>
    <artifactId>heisenberg-tck</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Heisenberg :: TCK Runner</name>
    <description>Harness de conformance MicroProfile Fault Tolerance 4.1 — TCK officiel TestNG/Arquillian</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <heisenberg.version>0.1.0-SNAPSHOT</heisenberg.version>
        <microprofile.fault.tolerance.version>4.1</microprofile.fault.tolerance.version>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
        <ravel.version>0.1.0-SNAPSHOT</ravel.version>
        <humboldt.version>0.1.0-SNAPSHOT</humboldt.version>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
                Aligner arquillian sur 1.10.1.Final pour éviter MalformedParameterizedTypeException
                sous JDK 25 (même contournement que knock-tck / cassini-tck / cyrano-tck).
            -->
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-spi</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.core</groupId>
                <artifactId>arquillian-core-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <!-- Force CDI API 4.1.0 finale -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Heisenberg (installé en local via le script TCK) -->
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-api</artifactId>
            <version>${heisenberg.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-core</artifactId>
            <version>${heisenberg.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-cdi-vauban</artifactId>
            <version>${heisenberg.version}</version>
        </dependency>

        <!-- MP FT API -->
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
            <version>${microprofile.fault.tolerance.version}</version>
        </dependency>

        <!-- Vauban CDI container -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>

        <!-- Ravel Config -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <version>${ravel.version}</version>
        </dependency>

        <!-- JUnit Jupiter pour smoke test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>4.0.0-beta-4</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Profil par défaut : smoke test JUnit — vérifie que les modules Heisenberg
            se chargent correctement et que la spec MP FT 4.1 est sur le classpath.
        -->
        <profile>
            <id>smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>io/vidocq/heisenberg/tck/arquillian/**</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <excludes>
                                <exclude>io/vidocq/heisenberg/tck/arquillian/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Profil TCK officiel : Arquillian TestNG + container Heisenberg custom
            (HeisenbergDeployableContainer démarrant Vauban embedded — voir ROADMAP.md M9).
            Cible : 100 % PASS.
        -->
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                                <include>**/*IT.class</include>
                            </includes>
                            <excludes>
                                <exclude>**/HeisenbergTckSmokeTest.class</exclude>
                            </excludes>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                            <systemPropertyVariables>
                                <arquillian.launch>heisenberg</arquillian.launch>
                                <!--
                                    Multiplicateur de timeout : scale tous les délais TCK
                                    pour les environnements CI lents.
                                    Valeur par défaut : 1.0 — augmenter à 2.0 ou 3.0 si
                                    les tests @Timeout échouent par faux positifs.
                                -->
                                <org.eclipse.microprofile.fault.tolerance.tck.timeout.multiplier>1.0</org.eclipse.microprofile.fault.tolerance.tck.timeout.multiplier>
                            </systemPropertyVariables>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-testng</artifactId>
                                <version>3.5.5</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <!-- TCK MicroProfile Fault Tolerance 4.1 -->
                <dependency>
                    <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
                    <artifactId>microprofile-fault-tolerance-tck</artifactId>
                    <version>${microprofile.fault.tolerance.version}</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>org.jboss.arquillian.testng</groupId>
                    <artifactId>arquillian-testng-container</artifactId>
                    <version>1.10.1.Final</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>io.vidocq.dirac</groupId>
                    <artifactId>dirac-cdi-vauban</artifactId>
                    <version>0.1.0-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>io.vidocq.humboldt</groupId>
                    <artifactId>humboldt-cdi</artifactId>
                    <version>${humboldt.version}</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                    <version>7.10.2</version>
                    <scope>test</scope>
                </dependency>

                <!-- Jakarta CDI API 4.1 -->
                <dependency>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                    <version>4.1.0</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.interceptor</groupId>
                    <artifactId>jakarta.interceptor-api</artifactId>
                    <version>2.2.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
